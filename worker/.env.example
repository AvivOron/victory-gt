TURSO_DB_URL=libsql://your-db-org.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your-token
# Leave empty on first run — scanner discovers and writes it to branch_id.txt
GANEI_TIKVA_BRANCH_ID=

# Optional. When set, the worker categorizes products during scans.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
