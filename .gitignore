# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example
!.env*.local.example

# python worker
worker/__pycache__/
worker/*.pyc
worker/branch_id.txt
worker/filelist_cache.json
worker/last_files_cache.json
worker/category_cache.json
worker/image_404_cache.json
worker/venv/
worker/images/

# local database
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates